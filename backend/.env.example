# Copy to .env (or set as real environment variables) -- never commit a real .env file.

BOOTSTRAP_TEACHER_EMAIL=teacher@aivya.edu
BOOTSTRAP_TEACHER_PASSWORD=change-this-password
BOOTSTRAP_TEACHER_NAME=Demo Teacher

# Base64-encoded HMAC key used to sign JWTs. Generate your own for any real deployment:
#   openssl rand -base64 32
JWT_SECRET=
